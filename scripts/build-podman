#!/usr/bin/env bash
# Run mkosi inside a pinned Fedora 45 container (Containerfile.build) instead of on the host.
# The prep steps (logos, RPMs) run on the host first, because they use rpmbuild and podman.
set -euo pipefail
cd "$(dirname "$0")/.."

arch="${1:-}"
case "$arch" in
  x86-64|arm64) ;;
  *) echo 'usage: scripts/build-podman x86-64|arm64' >&2; exit 2 ;;
esac
command -v podman >/dev/null || { echo 'podman is required' >&2; exit 1; }

scripts/prepare-build
podman build -f Containerfile.build -t localhost/ecp-mkosi:27.1 .

podman run --rm --privileged --userns=host \
  --security-opt label=disable \
  --volume "$PWD:/work:rw" --workdir /work \
  --entrypoint /usr/bin/bash localhost/ecp-mkosi:27.1 \
  -lc 'exec /opt/mkosi/bin/mkosi "$@" build' \
  bash --architecture="$arch"
