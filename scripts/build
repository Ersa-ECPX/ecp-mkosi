#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
expected='mkosi 27.1'
if ! command -v mkosi >/dev/null; then
  echo 'mkosi is required; see README.md' >&2
  exit 1
fi
actual="$(mkosi --version | head -n 1)"
if [[ "$actual" != "$expected" ]]; then
  echo "expected $expected; found $actual" >&2
  exit 1
fi
arch="${1:-}"
shift || true
case "$arch" in
  x86-64|arm64) ;;
  *) echo 'usage: scripts/build x86-64|arm64' >&2; exit 2 ;;
esac
scripts/prepare-build

# Images are signed for Secure Boot (mkosi.conf). Without a key, make a DEVELOPMENT one so a local build still works; its
# images boot everywhere Secure Boot is off, and where it is on only after enrolling that key. Releases use the real key
# (ECP_REQUIRE_SB_KEY=1 refuses to build without one).
if [[ ! -f secure-boot/ersa-secure-boot.key ]]; then
  if [[ "${ECP_REQUIRE_SB_KEY:-}" == 1 ]]; then echo "secure-boot/ersa-secure-boot.key is missing: run scripts/make-secure-boot-key (or restore your key)" >&2; exit 1; fi
  echo "no Secure Boot key: making a DEVELOPMENT key in secure-boot/ (scripts/make-secure-boot-key makes the same; keep the real one for releases)" >&2
  scripts/make-secure-boot-key >&2
fi

# mkosi's scratch space (TMPDIR) and caches (XDG_CACHE_HOME) default to /var/tmp and ~/.cache. On a
# ZFS root the rpm transaction there stalled for hours, so keep both on tmpfs. Override with
# ECP_WORK_DIR=/some/dir; contents are disposable. A build needs roughly 15 GiB free there.
work="${ECP_WORK_DIR:-/tmp/ecp-work}"
mkdir -p "$work/tmp" "$work/cache"
avail_gib="$(df --output=avail -BG "$work" | tail -n 1 | tr -dc '0-9')"
if (( avail_gib < 15 )); then
  echo "warning: only ${avail_gib} GiB free in $work; the build may run out of space (set ECP_WORK_DIR)" >&2
fi
export TMPDIR="$work/tmp" XDG_CACHE_HOME="$work/cache"

# The installer image carries its installer as a sysext on its data volume; stage it first.
installer=
case " $* " in
  *" --profile installer "*|*" --profile=installer "*|*" -p installer "*) installer=1 ;;
esac
[[ -z "$installer" ]] || scripts/build-installer-sysext "$arch"

# Extra arguments go to mkosi.
exec mkosi --architecture="$arch" "$@" build
