<script>
const NAV = {{NAV}};
const INDEX = {{INDEX}};
const $ = (s, r = document) => r.querySelector(s);
const pages = new Map([...document.querySelectorAll(".page")].map(p => [p.dataset.page, p]));
const nav = $("#nav");
for (const [group, info] of Object.entries(NAV)) {
  const h = document.createElement("h2"); h.textContent = group; h.title = info.blurb; nav.append(h);
  for (const it of info.pages) {
    const a = document.createElement("a"); a.href = "#/" + it.id; a.dataset.id = it.id;
    a.innerHTML = '<span class="dot ' + it.badge + '"></span>'; a.append(it.title.replace(/^Ersa Compute Platform documentation$/, "Overview")); nav.append(a);
  }
}
for (const h of document.querySelectorAll("article h1, article h2, article h3")) {
  const a = document.createElement("a"); a.className = "anchor"; a.href = "#"; a.textContent = " #"; a.style.cssText = "opacity:0;text-decoration:none;font-weight:400";
  a.addEventListener("click", e => { e.preventDefault(); const page = h.closest(".page").dataset.page; location.hash = "#/" + page + ":" + h.id; }); h.append(a);
}
for (const b of document.querySelectorAll(".copy")) b.addEventListener("click", () => {
  navigator.clipboard?.writeText(b.nextElementSibling.textContent).then(() => { b.textContent = "Copied"; setTimeout(() => b.textContent = "Copy", 1200); });
});
function show() {
  const [id, anchor] = decodeURIComponent(location.hash.replace(/^#\/?/, "")).split(":");
  const key = pages.has(id) ? id : "overview";
  $("#q").value = ""; $("#results").classList.remove("on"); $("#pages").style.display = "";
  for (const [k, p] of pages) p.classList.toggle("on", k === key);
  for (const a of nav.querySelectorAll("a")) a.classList.toggle("current", a.dataset.id === key);
  document.title = pages.get(key).dataset.title + " | Ersa Compute Platform";
  $("#side").classList.remove("open");
  const target = anchor && document.getElementById(anchor);
  if (target) target.scrollIntoView(); else window.scrollTo(0, 0);
}
addEventListener("hashchange", show); show();
const esc = s => s.replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
function search(q) {
  const terms = q.toLowerCase().split(/\s+/).filter(Boolean), box = $("#results");
  if (!terms.length) { show(); return; }
  const hits = [];
  for (const d of INDEX) {
    const low = d.text.toLowerCase(), t = d.title.toLowerCase();
    if (!terms.every(w => low.includes(w) || t.includes(w))) continue;
    const at = low.indexOf(terms[0]);
    let snip = at < 0 ? d.text.slice(0, 160) : d.text.slice(Math.max(0, at - 70), at + 120);
    snip = esc(snip); for (const w of terms) snip = snip.replace(new RegExp("(" + w.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + ")", "ig"), "<mark>$1</mark>");
    hits.push({ d, score: (terms.some(w => t.includes(w)) ? 10 : 0) + terms.reduce((n, w) => n + (low.split(w).length - 1), 0), snip });
  }
  hits.sort((a, b) => b.score - a.score);
  box.innerHTML = "<h2>" + hits.length + " result" + (hits.length === 1 ? "" : "s") + " for &ldquo;" + esc(q) + "&rdquo;</h2>" +
    hits.slice(0, 30).map(h => '<a href="#/' + h.d.id + '"><b>' + esc(h.d.title) + "</b><small>" + h.d.group + "</small><small>&hellip;" + h.snip + "&hellip;</small></a>").join("");
  box.classList.add("on"); $("#pages").style.display = "none";
}
$("#q").addEventListener("input", e => search(e.target.value));
addEventListener("keydown", e => {
  if (e.key === "/" && document.activeElement.tagName !== "INPUT") { e.preventDefault(); $("#q").focus(); }
  if (e.key === "Escape") { $("#q").value = ""; show(); $("#q").blur(); }
});
$(".menu").addEventListener("click", () => $("#side").classList.toggle("open"));
const root = document.documentElement, saved = (() => { try { return localStorage.getItem("theme"); } catch (e) { return null; } })();
if (saved) root.dataset.theme = saved;
$(".theme").addEventListener("click", () => {
  const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
  root.dataset.theme = dark ? "light" : "dark"; try { localStorage.setItem("theme", root.dataset.theme); } catch (e) {}
});
</script>
</body>
</html>
"""


def main(argv):
    output = argv[1] if len(argv) > 1 else os.path.join(ROOT, "docs/wiki/index.html")
    document, problems = build(output)
    for source, target in problems:
        print(f"note: {source}: link to {target} is not part of the wiki; shown as plain text", file=sys.stderr)
    pages = len(re.findall(r'class="page"', document))
    print(f"wrote {output} ({pages} pages, {len(document) // 1024} KiB)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
