<script>
const NAV = {{NAV}};
const INDEX = {{INDEX}};
const $ = (s, r = document) => r.querySelector(s);
const pages = new Map([...document.querySelectorAll(".page")].map(p => [p.dataset.page, p]));
const nav = $("#nav"), order = [];
for (const [group, info] of Object.entries(NAV)) {
  const h = document.createElement("h2"); h.textContent = group; h.title = info.blurb; nav.append(h);
  for (const it of info.pages) {
    const title = it.title.replace(/^Ersa Compute Platform documentation$/, "Overview");
    const a = document.createElement("a"); a.href = "#/" + it.id; a.dataset.id = it.id; a.textContent = title; nav.append(a);
    order.push({ id: it.id, title, group });
  }
}
for (const [id, page] of pages) {                       // breadcrumb, edit link and heading anchors, once
  const src = page.dataset.src, repo = src.startsWith("foundation/") ? ["foundation", src.slice(11)] : ["ecp-mkosi", src];
  const crumb = document.createElement("div"); crumb.className = "crumb";
  crumb.innerHTML = "<span>" + page.dataset.group.replace(/&/g, "&amp;") + '</span><a class="edit" href="https://github.com/Ersa-ECPX/' + repo[0] + "/blob/main/" + repo[1] + '">Edit on GitHub</a>';
  page.prepend(crumb);
  for (const h of page.querySelectorAll("article h1, article h2, article h3")) {
    const a = document.createElement("a"); a.className = "anchor"; a.href = "#"; a.textContent = " #"; a.style.cssText = "opacity:0;text-decoration:none;font-weight:400";
    a.addEventListener("click", e => { e.preventDefault(); location.hash = "#/" + id + ":" + h.id; }); h.append(a);
  }
}
for (const b of document.querySelectorAll(".copy")) b.addEventListener("click", () => {
  navigator.clipboard?.writeText(b.nextElementSibling.textContent).then(() => { b.textContent = "Copied"; setTimeout(() => b.textContent = "Copy", 1200); });
});
let spy = null;
function contents(page, key) {
  const toc = $("#toc"); toc.innerHTML = ""; if (spy) spy.disconnect();
  const heads = [...page.querySelectorAll("article h2, article h3")].filter(h => h.id);
  if (heads.length < 3) return;
  toc.insertAdjacentHTML("beforeend", "<h3>On this page</h3>");
  const links = new Map();
  for (const h of heads) {
    const a = document.createElement("a"); a.href = "#/" + key + ":" + h.id; if (h.tagName === "H3") a.className = "sub";
    a.textContent = h.textContent.replace(/\s*#\s*$/, ""); toc.append(a); links.set(h, a);
  }
  spy = new IntersectionObserver(entries => {
    for (const e of entries) if (e.isIntersecting) { for (const a of toc.querySelectorAll("a")) a.classList.remove("on"); links.get(e.target).classList.add("on"); }
  }, { rootMargin: "-10% 0px -80% 0px" });
  for (const h of heads) spy.observe(h);
}
function pager(key) {
  const i = order.findIndex(o => o.id === key), box = $("#pager"); box.innerHTML = "";
  const link = (o, cls, label) => '<a class="' + cls + '" href="#/' + o.id + '"><small>' + label + "</small>" + o.title.replace(/&/g, "&amp;") + "</a>";
  if (i > 0) box.insertAdjacentHTML("beforeend", link(order[i - 1], "prev", "Previous"));
  if (i >= 0 && i < order.length - 1) box.insertAdjacentHTML("beforeend", link(order[i + 1], "next", "Next"));
}
function show() {
  const [id, anchor] = decodeURIComponent(location.hash.replace(/^#\/?/, "")).split(":");
  const key = pages.has(id) ? id : "overview";
  $("#q").value = ""; $("#results").classList.remove("on"); $("#pages").style.display = ""; $("#pager").style.display = "";
  for (const [k, p] of pages) p.classList.toggle("on", k === key);
  for (const a of nav.querySelectorAll("a")) a.classList.toggle("current", a.dataset.id === key);
  document.title = pages.get(key).dataset.title + " | Ersa Compute Platform";
  $("#side").classList.remove("open");
  contents(pages.get(key), key); pager(key);
  const target = anchor && document.getElementById(anchor);
  if (target) target.scrollIntoView(); else window.scrollTo(0, 0);
}
addEventListener("hashchange", show); show();
const esc = s => s.replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
let shown = [], selected = -1;
function search(q) {
  const terms = q.toLowerCase().split(/\s+/).filter(Boolean), box = $("#results");
  if (!terms.length) { show(); return; }
  const hits = [];
  for (const d of INDEX) {
    const low = d.text.toLowerCase(), t = d.title.toLowerCase();
    if (!terms.every(w => low.includes(w) || t.includes(w))) continue;
    const at = low.indexOf(terms[0]);
    let snip = at < 0 ? d.text.slice(0, 160) : d.text.slice(Math.max(0, at - 70), at + 120);
    snip = esc(snip); for (const w of terms) snip = snip.replace(new RegExp("(" + w.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + ")", "ig"), "<mark>$1</mark>");
    hits.push({ d, score: (terms.some(w => t.includes(w)) ? 10 : 0) + terms.reduce((n, w) => n + (low.split(w).length - 1), 0), snip });
  }
  hits.sort((a, b) => b.score - a.score); shown = hits.slice(0, 30); selected = -1;
  box.innerHTML = "<h2>" + hits.length + " result" + (hits.length === 1 ? "" : "s") + " for &ldquo;" + esc(q) + "&rdquo;</h2>" +
    shown.map(h => '<a href="#/' + h.d.id + '"><b>' + esc(h.d.title) + "</b><small>" + h.d.group + "</small><small>&hellip;" + h.snip + "&hellip;</small></a>").join("");
  box.classList.add("on"); $("#pages").style.display = "none"; $("#pager").style.display = "none"; $("#toc").innerHTML = "";
}
$("#q").addEventListener("input", e => search(e.target.value));
$("#q").addEventListener("keydown", e => {                // arrow keys walk the results, Enter opens one
  const links = [...document.querySelectorAll("#results a")];
  if (!links.length || !["ArrowDown", "ArrowUp", "Enter"].includes(e.key)) return;
  e.preventDefault();
  if (e.key === "Enter") { (links[selected] || links[0]).click(); return; }
  selected = Math.max(0, Math.min(links.length - 1, selected + (e.key === "ArrowDown" ? 1 : -1)));
  links.forEach((a, i) => a.classList.toggle("sel", i === selected)); links[selected].scrollIntoView({ block: "nearest" });
});
addEventListener("keydown", e => {
  if (e.key === "/" && document.activeElement.tagName !== "INPUT") { e.preventDefault(); $("#q").focus(); }
  if (e.key === "Escape") { $("#q").value = ""; show(); $("#q").blur(); }
});
$(".menu").addEventListener("click", () => $("#side").classList.toggle("open"));
const root = document.documentElement, saved = (() => { try { return localStorage.getItem("theme"); } catch (e) { return null; } })();
if (saved) root.dataset.theme = saved;
$(".theme").addEventListener("click", () => {
  const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
  root.dataset.theme = dark ? "light" : "dark"; try { localStorage.setItem("theme", root.dataset.theme); } catch (e) {}
});
</script>
</body>
</html>
"""


def main(argv):
    arguments, cname, i = [], "", 1
    while i < len(argv):
        if argv[i] == "--cname" and i + 1 < len(argv):
            cname, i = argv[i + 1], i + 2
        else:
            arguments.append(argv[i])
            i += 1
    output = arguments[0] if arguments else os.path.join(ROOT, "docs/wiki/index.html")
    document, problems = build(output, cname=cname)
    for source, target in problems:
        print(f"note: {source}: {target} is not part of the wiki; shown as plain text", file=sys.stderr)
    pages = len(re.findall(r'class="page"', document))
    print(f"wrote {output} ({pages} pages, {len(document) // 1024} KiB)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
