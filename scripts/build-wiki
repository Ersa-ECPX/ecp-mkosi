#!/usr/bin/env python3
"""Build a small, self-contained wiki (one HTML file) from the project's Markdown documentation.

    scripts/build-wiki [OUTPUT]        default: docs/wiki/index.html

The page has a sidebar, full-text search, light and dark themes and no external files, fonts or scripts, so it works
from a file:// URL, a USB stick or any static host. It is generated: edit the Markdown under docs/ (and
foundation/README.md) and run this again.

What is included, and how it is grouped, is described by docs/wiki.json: a list of categories (Architecture,
Foundation, App support, Installer, ...), each with a one-line description and its pages in reading order. Any Markdown
file under docs/ that the file does not mention is added under "Other", so nothing is silently left out. Links between
included pages become in-page links; a link to anything else (a source file, say) is shown as plain text so nothing is
left dangling.

The Markdown converter handles exactly what these documents use (headings, paragraphs, fenced code, tables whose cells
may hold `|` inside code, nested lists, emphasis, code spans, links, rules) and escapes all other HTML.
"""

import datetime
import html
import json
import os
import posixpath
import re
import subprocess
import sys

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))



# -- Markdown ----------------------------------------------------------------------------------

LIST_ITEM = re.compile(r"^(\s*)([-*]|\d+\.)\s+(.*)$")
TABLE_SEPARATOR = re.compile(r"^\s*\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)*\|?\s*$")


def slug(text):
    text = re.sub(r"<[^>]+>|[`*_]", "", text).lower()
    text = re.sub(r"[^\w\s-]", "", text)
    return re.sub(r"\s+", "-", text.strip()) or "section"


class Converter:
    """Markdown to HTML for one page. `resolve(href)` maps a link target to (href, is_page) or None."""

    def __init__(self, resolve):
        self.resolve = resolve
        self.headings, self.title, self.used = [], "", {}

    # inline
    def inline(self, text):
        codes = []

        def stash(match):
            codes.append(match.group(2))
            return f"\x00{len(codes) - 1}\x00"
        text = re.sub(r"(`+)(.+?)\1", stash, text)
        text = html.escape(text, quote=False)
        text = re.sub(r"\[([^\]]+)\]\(([^)\s]+)\)", self._link, text)
        text = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", text)
        text = re.sub(r"(?<![\w*])\*(?!\s)(.+?)(?<!\s)\*(?![\w*])", r"<em>\1</em>", text)
        return re.sub(r"\x00(\d+)\x00", lambda m: "<code>" + html.escape(codes[int(m.group(1))], quote=False) + "</code>", text)

    def _link(self, match):
        label, target = match.group(1), html.unescape(match.group(2))
        if re.match(r"^[a-z][a-z0-9+.-]*:", target):                  # an absolute URL
            return f'<a href="{html.escape(target)}" rel="noopener">{label}</a>'
        resolved = self.resolve(target)
        if resolved is None:
            return f'<span class="filelink" title="{html.escape(target)}">{label}</span>'
        return f'<a href="{html.escape(resolved)}">{label}</a>'

    # blocks
    def convert(self, text):
        lines = text.replace("\r\n", "\n").split("\n")
        return self.blocks(lines)

    def heading_id(self, title, explicit=None):
        base = explicit or slug(title)
        count = self.used.get(base, 0)
        self.used[base] = count + 1
        return base if count == 0 else f"{base}-{count}"

    def blocks(self, lines):
        out, i, n = [], 0, len(lines)
        while i < n:
            line = lines[i]
            if not line.strip():
                i += 1
            elif line.startswith("```"):
                language, i = line[3:].strip(), i + 1
                body = []
                while i < n and not lines[i].startswith("```"):
                    body.append(lines[i])
                    i += 1
                i += 1
                out.append(f'<pre><button class="copy" type="button">Copy</button><code>{html.escape(chr(10).join(body), quote=False)}</code></pre>')
            elif re.match(r"^#{1,6}\s", line):
                level = len(line) - len(line.lstrip("#"))
                raw = line[level:].strip()
                anchor = re.search(r'<a id="([^"]+)"></a>', raw)
                raw = re.sub(r'<a id="[^"]+"></a>', "", raw).strip()
                ident = self.heading_id(raw, anchor.group(1) if anchor else None)
                if level == 1 and not self.title:
                    self.title = re.sub(r"[`*]", "", raw)
                self.headings.append((level, re.sub(r"[`*]", "", raw), ident))
                out.append(f'<h{level} id="{ident}">{self.inline(raw)}</h{level}>')
                i += 1
            elif re.match(r"^---+\s*$", line):
                out.append("<hr>")
                i += 1
            elif line.lstrip().startswith("|") and i + 1 < n and TABLE_SEPARATOR.match(lines[i + 1]):
                html_table, i = self.table(lines, i)
                out.append(html_table)
            elif LIST_ITEM.match(line):
                html_list, i = self.list(lines, i)
                out.append(html_list)
            else:
                paragraph = [line.strip()]
                i += 1
                while i < n and lines[i].strip() and not self._starts_block(lines, i):
                    paragraph.append(lines[i].strip())
                    i += 1
                out.append(f"<p>{self.inline(' '.join(paragraph))}</p>")
        return "\n".join(out)

    @staticmethod
    def _starts_block(lines, i):
        line = lines[i]
        return (line.startswith("```") or re.match(r"^#{1,6}\s", line) or LIST_ITEM.match(line)
                or re.match(r"^---+\s*$", line)
                or (line.lstrip().startswith("|") and i + 1 < len(lines) and TABLE_SEPARATOR.match(lines[i + 1])))

    @staticmethod
    def split_row(line):
        """Cells of a table row; a `|` inside a code span or escaped as \\| belongs to the cell."""
        line = line.strip()
        if line.startswith("|"):
            line = line[1:]
        if line.endswith("|") and not line.endswith("\\|"):
            line = line[:-1]
        cells, current, in_code, i = [], [], False, 0
        while i < len(line):
            char = line[i]
            if char == "\\" and i + 1 < len(line) and line[i + 1] == "|":
                current.append("|")
                i += 2
                continue
            if char == "`":
                in_code = not in_code
            if char == "|" and not in_code:
                cells.append("".join(current).strip())
                current = []
            else:
                current.append(char)
            i += 1
        cells.append("".join(current).strip())
        return cells

    def table(self, lines, i):
        header = self.split_row(lines[i])
        alignments = []
        for cell in self.split_row(lines[i + 1]):
            left, right = cell.startswith(":"), cell.endswith(":")
            alignments.append("center" if left and right else "right" if right else "left" if left else "")
        i += 2
        rows = []
        while i < len(lines) and lines[i].strip().startswith("|"):
            rows.append(self.split_row(lines[i]))
            i += 1

        def cell(tag, text, column):
            style = f' style="text-align:{alignments[column]}"' if column < len(alignments) and alignments[column] else ""
            return f"<{tag}{style}>{self.inline(text)}</{tag}>"
        head = "".join(cell("th", text, c) for c, text in enumerate(header))
        body = "".join("<tr>" + "".join(cell("td", text, c) for c, text in enumerate(row)) + "</tr>" for row in rows)
        return f'<div class="table"><table><thead><tr>{head}</tr></thead><tbody>{body}</tbody></table></div>', i

    def list(self, lines, i):
        first = LIST_ITEM.match(lines[i])
        indent = len(first.group(1))
        ordered = first.group(2)[0].isdigit()
        items = []
        while i < len(lines):
            match = LIST_ITEM.match(lines[i])
            if not match or len(match.group(1)) != indent:
                break
            width = len(match.group(1)) + len(match.group(2)) + 1
            body = [match.group(3)]
            i += 1
            while i < len(lines):
                line = lines[i]
                if not line.strip():
                    following = next((l for l in lines[i + 1:i + 3] if l.strip()), "")
                    if following.startswith(" " * (width + 1)) or (following and LIST_ITEM.match(following)
                                                                   and len(LIST_ITEM.match(following).group(1)) > indent):
                        body.append("")
                        i += 1
                        continue
                    break
                if len(line) - len(line.lstrip()) > indent and not (LIST_ITEM.match(line) and len(LIST_ITEM.match(line).group(1)) == indent):
                    body.append(line[min(width, len(line) - len(line.lstrip())):] if line.startswith(" " * width) else line.strip())
                    i += 1
                    continue
                break
            items.append(body)
        tag = "ol" if ordered else "ul"
        rendered = []
        for body in items:
            split = next((k for k, l in enumerate(body) if k and LIST_ITEM.match(l)), len(body))
            text = " ".join(l.strip() for l in body[:split] if l.strip())
            nested = self.blocks(body[split:]) if split < len(body) else ""
            rendered.append(f"<li>{self.inline(text)}{nested}</li>")
        return f"<{tag}>" + "".join(rendered) + f"</{tag}>", i


# -- the site ----------------------------------------------------------------------------------

def read(path):
    with open(os.path.join(ROOT, path), encoding="utf-8") as handle:
        return handle.read()


def page_id(path):
    if path == "docs/README.md":
        return "overview"
    if path == "foundation/README.md":
        return "developer-guide"
    stem = path[len("docs/"):-3] if path.startswith("docs/") else path[:-3]
    return stem


def categories():
    """[{"title", "blurb", "pages": [{"path", "label"?}, ...]}] from docs/wiki.json, plus an "Other" group for unlisted documents."""
    with open(os.path.join(ROOT, "docs/wiki.json"), encoding="utf-8") as handle:
        result = json.load(handle)["categories"]
    for category in result:
        category["pages"] = [entry if isinstance(entry, dict) else {"path": entry} for entry in category["pages"]]
    listed = {entry["path"] for category in result for entry in category["pages"]}
    found = []
    for directory in ("docs", "docs/features"):
        for name in sorted(os.listdir(os.path.join(ROOT, directory))):
            path = f"{directory}/{name}"
            if name.endswith(".md") and path not in listed:
                found.append(path)
    if found:
        result.append({"title": "Other", "blurb": "Documents not yet placed in a category.", "pages": [{"path": f} for f in found]})
    for category in result:
        for entry in category["pages"]:
            if not os.path.isfile(os.path.join(ROOT, entry["path"])):
                raise SystemExit(f"docs/wiki.json lists {entry['path']}, which does not exist")
    return result


def page_list():
    """[(id, source path, category title)] in reading order."""
    return [(page_id(entry["path"]), entry["path"], category["title"]) for category in categories() for entry in category["pages"]]


def labels():
    return {entry["path"]: entry["label"] for category in categories() for entry in category["pages"] if entry.get("label")}


def badge(markdown):
    """(label, class) from a page's leading **Status:** line, or None."""
    match = re.search(r"^\*\*Status:(.+?)(?:\n\n|\Z)", markdown, re.S | re.M)
    if not match:
        return None
    text = " ".join(match.group(1).replace("*", " ").split()).lstrip(": ").lower()
    if "scaffolding only" in text or text.startswith("not "):
        return "Not usable yet", "bad"
    if text.startswith(("partly", "partial")):
        return "Partly built", "mid"
    if text.startswith(("built", "implemented")) or re.search(r"\bbuilt\b", text[:140]):
        return "Built", "ok"
    return None


def plain(markdown):
    text = re.sub(r"```.*?```", lambda m: m.group(0).replace("```", " "), markdown, flags=re.S)
    text = re.sub(r"\[([^\]]+)\]\([^)]*\)", r"\1", text)
    text = re.sub(r"[`*#|>]", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def build(output=None, pages=None):
    pages = pages or page_list()
    blurbs = {category["title"]: category["blurb"] for category in categories()}
    short = labels()
    by_path = {os.path.normpath(os.path.join(ROOT, src)): pid for pid, src, _g in pages}
    sections, nav, index = [], {}, []
    problems = []
    for pid, src, group in pages:
        directory = posixpath.dirname(src)
        markdown = read(src)

        def resolve(target, directory=directory, src=src):
            path, _hash, anchor = target.partition("#")
            if not path:
                return f"#/{pid_of[src]}:{anchor}" if anchor else f"#/{pid_of[src]}"
            absolute = os.path.normpath(os.path.join(ROOT, directory, path))
            if absolute in by_path:
                return f"#/{by_path[absolute]}" + (f":{anchor}" if anchor else "")
            problems.append((src, target))
            return None
        pid_of = {s: p for p, s, _g in pages}
        converter = Converter(resolve)
        body = converter.convert(markdown)
        status = badge(markdown)
        label = f'<span class="badge {status[1]}">{status[0]}</span>' if status else ""
        title = converter.title or pid
        sections.append(f'<section class="page" data-page="{pid}" data-title="{html.escape(title)}"><div class="meta">'
                        f'{html.escape(group)} {label}<span class="src">{html.escape(src)}</span></div>'
                        f'<article>{body}</article></section>')
        nav.setdefault(group, {"blurb": blurbs.get(group, ""), "pages": []})["pages"].append(
            {"id": pid, "title": short.get(src, title), "badge": status[1] if status else ""})
        index.append({"id": pid, "title": title, "group": group, "text": plain(markdown)})
    commit = ""
    try:
        commit = subprocess.run(["git", "-C", ROOT, "log", "-1", "--format=%h %cd", "--date=short"], capture_output=True,
                                text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    generated = datetime.date.today().isoformat() + (f", from commit {commit}" if commit else "")
    document = TEMPLATE.replace("{{SECTIONS}}", "\n".join(sections)).replace("{{NAV}}", json.dumps(nav)) \
        .replace("{{INDEX}}", json.dumps(index).replace("</", "<\\/")).replace("{{GENERATED}}", html.escape(generated))
    if output:
        os.makedirs(os.path.dirname(os.path.abspath(output)), exist_ok=True)
        with open(output, "w", encoding="utf-8") as handle:
            handle.write(document)
    return document, problems


