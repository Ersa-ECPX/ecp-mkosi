#!/usr/bin/env python3
"""Publish the update feed that the update window and `ota.url` read, on a fixed GitHub release named `updates`.

    scripts/publish-feed 0.1.2 [--repo OWNER/NAME] [--dry-run]

Run it AFTER the release v<version> is published (not a draft): the feed points at that release's update archive, and the assets of a
draft cannot be downloaded by anyone else. It uploads one small file, latest-x86_64.json, to the release `updates` (created the first
time), replacing the previous one:

    ota.url = https://github.com/<repo>/releases/download/updates      (the feed is <ota.url>/latest-x86_64.json)

The archive's size and checksum come from the file in dist/release/<version>/ (or dist/update/). The feed is not signed: the archive
carries its own signed manifest, which the system checks. Needs an authenticated `gh`; --dry-run prints what it would do and changes nothing.
"""

import argparse
import hashlib
import json
import os
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ARCH = "x86_64"
FEED_TAG = "updates"


def gh(*args, check=True):
    return subprocess.run(["gh", *args], check=check, capture_output=True, text=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("version")
    parser.add_argument("--repo")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    name = f"ecp_{args.version}-{ARCH}.tar.zst"
    archive = next((p for p in (os.path.join(ROOT, "dist", "release", args.version, name), os.path.join(ROOT, "dist", "update", name))
                    if os.path.isfile(p)), None)
    if archive is None:
        sys.exit(f"cannot find {name} in dist/release/{args.version}/ or dist/update/")
    repo = args.repo
    if not repo:
        found = gh("repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner", check=False)
        repo = found.stdout.strip() or "Ersa-ECPX/ecp-mkosi"
    tag = "v" + args.version
    digest = hashlib.sha256()
    with open(archive, "rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    feed = {"version": args.version, "arch": ARCH, "size": os.path.getsize(archive), "sha256": digest.hexdigest(),
            "file": f"https://github.com/{repo}/releases/download/{tag}/{name}"}
    text = json.dumps(feed, indent=2) + "\n"
    if args.dry_run:
        print(text, end="")
        print(f"would upload it as latest-{ARCH}.json to the release '{FEED_TAG}' of {repo} (created if it does not exist)")
        print(f"ota.url = https://github.com/{repo}/releases/download/{FEED_TAG}")
        return
    release = gh("release", "view", tag, "-R", repo, "--json", "isDraft", "-q", ".isDraft", check=False)
    if release.returncode != 0:
        sys.exit(f"the release {tag} does not exist in {repo}; run scripts/release {args.version} first")
    if release.stdout.strip() == "true":
        sys.exit(f"the release {tag} is still a draft: publish it first, or nobody can download the archive the feed points at")
    if gh("release", "view", FEED_TAG, "-R", repo, check=False).returncode != 0:
        gh("release", "create", FEED_TAG, "-R", repo, "--target", "main", "--prerelease", "--latest=false",
           "--title", "Update feed", "--notes", f"The file latest-{ARCH}.json here names the newest system update; the update window reads it "
           "(setting ota.url). Overwritten on every release. Do not delete.")
    with tempfile.TemporaryDirectory() as tmp:
        path = os.path.join(tmp, f"latest-{ARCH}.json")
        with open(path, "w", encoding="utf-8") as handle:
            handle.write(text)
        result = gh("release", "upload", FEED_TAG, path, "-R", repo, "--clobber", check=False)
        if result.returncode != 0:
            sys.exit("upload failed: " + result.stderr.strip())
    print(f"published {tag} as the newest update: https://github.com/{repo}/releases/download/{FEED_TAG}/latest-{ARCH}.json")
    print(f"ota.url = https://github.com/{repo}/releases/download/{FEED_TAG}")


if __name__ == "__main__":
    main()
