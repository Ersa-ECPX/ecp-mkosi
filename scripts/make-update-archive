#!/usr/bin/env python3
"""Make an update archive that `foundation update install` reads, from the output of the `root` profile.

    scripts/build x86-64 --profile root
    scripts/make-update-archive 0.2.0                       # unsigned: only for an image you built yourself
    ECP_SIGN_KEY=<key id> scripts/make-update-archive 0.2.0 --sign

Reads  mkosi.output/root/ecp_<version>.root-x86-64.raw[.zst]         (the root filesystem, EROFS)
       mkosi.output/root/ecp_<version>.root-x86-64-verity.raw[.zst]  (its dm-verity hash tree: mkosi's own name for it)
       mkosi.output/root/ecp_<version>.efi                           (the unified kernel image)
       mkosi.output/root/ecp_<version>.roothash                      (the root hash; if absent it is read from the kernel image,
                                                                      which carries it as roothash= on its command line)
Writes dist/update/latest-x86_64.json (the feed the updater window reads: version, file, size, sha256) and
       dist/update/ecp_<version>-x86_64.tar.zst holding exactly: manifest.json (first), manifest.json.sig (with
--sign), uki.efi, root.erofs, verity.img (the small kernel image comes first so the installer can read it before the images). The manifest names the root hash and the size and SHA-256 of the three files. The manifest is what is signed and names the size and SHA-256 of the two big files.
The signing key must live outside this repository, in your GPG keyring (scripts/make-image-signing-key makes one;
ECP_SIGN_PASSPHRASE_FILE names a file holding its passphrase, for unattended signing); the system trusts a key only if its public
half is installed as /usr/share/foundation/keys/ersa-image-*.asc or /etc/foundation/keys/ersa-image-*.asc.
"""

import argparse
import hashlib
import json
import os
import subprocess
import sys
import tarfile
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
ARCH = {"x86-64": "x86_64", "arm64": "aarch64"}


def digest(path):
    h = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def find(directory, stem):
    """`stem` as mkosi wrote it: compressed (.zst) or not."""
    for name in (stem + ".zst", stem):
        path = os.path.join(directory, name)
        if os.path.isfile(path):
            return path
    return None


def unpack(path, handle):
    """Write the contents of `path` (zstd-compressed or plain) to the open file `handle`."""
    if path.endswith(".zst"):
        subprocess.run(["zstd", "-dc", "--", path], stdout=handle, check=True)
    else:
        with open(path, "rb") as source:
            while chunk := source.read(1 << 20):
                handle.write(chunk)


def read_roothash(roothash_file, uki):
    """The root hash from mkosi's .roothash file, checked against (or, if there is no file, taken from) the kernel image."""
    sys.path.insert(0, os.path.join(ROOT, "foundation"))
    from foundationd.backends import verity
    named = verity.roothash_of(verity.cmdline_of_file(uki))
    if os.path.isfile(roothash_file):
        with open(roothash_file, encoding="ascii") as handle:
            roothash = handle.read().strip().lower()
        if named and named != roothash:
            sys.exit(f"{roothash_file} says {roothash} but the kernel image names {named}; the build output is inconsistent")
        return roothash
    if not named:
        sys.exit(f"no root hash: {roothash_file} is missing and the kernel image has no roothash= on its command line")
    return named


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("version")
    parser.add_argument("--arch", default="x86-64", choices=sorted(ARCH))
    parser.add_argument("--source", default=os.path.join(ROOT, "mkosi.output", "root"))
    parser.add_argument("--output", default=os.path.join(ROOT, "dist", "update"))
    parser.add_argument("--base-url", help="write the update feed's file as BASE_URL/<archive name> (an absolute address) instead of a name relative to the feed")
    parser.add_argument("--sign", action="store_true", help="sign manifest.json with the GPG key in $ECP_SIGN_KEY")
    args = parser.parse_args()

    uki = os.path.join(args.source, f"ecp_{args.version}.efi")
    root_zst = find(args.source, f"ecp_{args.version}.root-{args.arch}.raw")
    verity_zst = find(args.source, f"ecp_{args.version}.root-{args.arch}-verity.raw")
    for what, path in (("the root image", root_zst), ("the dm-verity hash tree", verity_zst), ("the kernel image", uki if os.path.isfile(uki) else None)):
        if path is None:
            sys.exit(f"missing {what} for {args.version} in {args.source}; build it with: scripts/build {args.arch} --profile root --image-version {args.version}")
    roothash_file = os.path.join(args.source, f"ecp_{args.version}.roothash")
    key = os.environ.get("ECP_SIGN_KEY", "")
    if args.sign and not key:
        sys.exit("--sign needs ECP_SIGN_KEY (a GPG key id)")
    os.makedirs(args.output, exist_ok=True)
    out = os.path.join(args.output, f"ecp_{args.version}-{ARCH[args.arch]}.tar.zst")

    with tempfile.TemporaryDirectory(dir=args.output, prefix="work.") as work:
        erofs = os.path.join(work, "root.erofs")
        with open(erofs, "wb") as handle:
            unpack(root_zst, handle)
        tree = os.path.join(work, "verity.img")
        with open(tree, "wb") as handle:
            unpack(verity_zst, handle)
        roothash = read_roothash(roothash_file, uki)
        manifest = {"format": 1, "name": "ecp", "version": args.version, "arch": ARCH[args.arch], "roothash": roothash,
                    "root": {"file": "root.erofs", "sha256": digest(erofs), "size": os.path.getsize(erofs)},
                    "verity": {"file": "verity.img", "sha256": digest(tree), "size": os.path.getsize(tree)},
                    "uki": {"file": "uki.efi", "sha256": digest(uki), "size": os.path.getsize(uki)}}
        manifest_path = os.path.join(work, "manifest.json")
        with open(manifest_path, "w", encoding="utf-8") as handle:
            json.dump(manifest, handle, indent=1)
            handle.write("\n")
        members = [("manifest.json", manifest_path)]
        if args.sign:
            signature = manifest_path + ".sig"
            command = ["gpg", "--batch", "--yes", "--armor", "--detach-sign", "-u", key, "-o", signature]
            if os.environ.get("ECP_SIGN_PASSPHRASE_FILE"):
                command += ["--pinentry-mode", "loopback", "--passphrase-file", os.environ["ECP_SIGN_PASSPHRASE_FILE"]]
            subprocess.run(command + [manifest_path], check=True)
            members.append(("manifest.json.sig", signature))
        members += [("uki.efi", uki), ("root.erofs", erofs), ("verity.img", tree)]
        with open(out, "wb") as target:
            compressor = subprocess.Popen(["zstd", "-T0", "-10", "-q"], stdin=subprocess.PIPE, stdout=target)
            with tarfile.open(fileobj=compressor.stdin, mode="w|") as tar:
                for name, path in members:
                    info = tar.gettarinfo(path, arcname=name)
                    info.uid = info.gid = 0
                    info.uname = info.gname = ""
                    info.mode = 0o644
                    with open(path, "rb") as handle:
                        tar.addfile(info, handle)
            compressor.stdin.close()
            if compressor.wait() != 0:
                sys.exit("zstd failed")
    # the feed the updater window reads (`<ota.url>/latest-<arch>.json`); it only says what is available, the archive's own
    # signed manifest is what foundationd verifies
    feed = os.path.join(args.output, f"latest-{ARCH[args.arch]}.json")
    with open(feed, "w", encoding="utf-8") as handle:
        json.dump({"version": args.version, "arch": ARCH[args.arch], "file": (args.base_url.rstrip("/") + "/" if args.base_url else "") + os.path.basename(out),
                   "size": os.path.getsize(out), "sha256": digest(out)}, handle, indent=2)
        handle.write("\n")
    print(out)
    print(feed)
    print("install it with: foundation update install " + os.path.relpath(out) + ("" if args.sign else " --unsigned"))


if __name__ == "__main__":
    main()
