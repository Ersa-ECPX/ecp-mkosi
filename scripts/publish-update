#!/usr/bin/env bash
# Assemble the files an update server serves, from the output of the `root` profile:
#   scripts/build x86-64 --profile root            # writes mkosi.output/root/
#   scripts/publish-update [--sign] [SOURCE_DIR] [DEST_DIR]
# Defaults: SOURCE_DIR=mkosi.output/root  DEST_DIR=dist/x86-64
#
# DEST_DIR gets, for every version found, ecp_<version>.root-x86-64.raw.zst and ecp_<version>.efi,
# plus ONE SHA256SUMS listing all of them (systemd-sysupdate reads a single manifest per source URL;
# mkosi writes one checksum file per build, so they are not used). Versions already in DEST_DIR are
# kept, so running this after each build accumulates the available versions.
#
# --sign writes SHA256SUMS.gpg (a detached signature) with gpg; set ECP_SIGN_KEY to the key id.
# The private key must live outside this repository. Without --sign the transfer files must say
# Verify=no, which is for tests only.
set -euo pipefail
cd "$(dirname "$0")/.."

sign=0
if [[ "${1:-}" == "--sign" ]]; then sign=1; shift; fi
src="${1:-mkosi.output/root}"
dest="${2:-dist/x86-64}"

shopt -s nullglob
root_files=("$src"/ecp_*.root-x86-64.raw.zst)
uki_files=("$src"/ecp_*.efi)
if (( ${#root_files[@]} == 0 || ${#uki_files[@]} == 0 )); then
  echo "no payloads in $src; build them with: scripts/build x86-64 --profile root" >&2
  exit 1
fi

# Every version needs both its root image and its kernel image, or an update would half-install.
for f in "${root_files[@]}"; do
  version="$(basename "$f")"; version="${version#ecp_}"; version="${version%.root-x86-64.raw.zst}"
  [[ -e "$src/ecp_${version}.efi" ]] || { echo "version $version has a root image but no ecp_${version}.efi" >&2; exit 1; }
done
for f in "${uki_files[@]}"; do
  version="$(basename "$f")"; version="${version#ecp_}"; version="${version%.efi}"
  [[ -e "$src/ecp_${version}.root-x86-64.raw.zst" ]] || { echo "version $version has a kernel image but no root image" >&2; exit 1; }
done

mkdir -p "$dest"
for f in "${root_files[@]}" "${uki_files[@]}"; do
  cp --reflink=auto -f -- "$f" "$dest/"
done

# --binary, as the manual recommends. Only the payloads are listed.
( cd "$dest" && sha256sum --binary ecp_*.root-x86-64.raw.zst ecp_*.efi > SHA256SUMS )

if (( sign )); then
  command -v gpg >/dev/null || { echo "gpg is required for --sign" >&2; exit 1; }
  key=()
  [[ -n "${ECP_SIGN_KEY:-}" ]] && key=(--local-user "$ECP_SIGN_KEY")
  rm -f "$dest/SHA256SUMS.gpg"
  gpg --batch --yes "${key[@]}" --detach-sign --output "$dest/SHA256SUMS.gpg" "$dest/SHA256SUMS"
  echo "signed: $dest/SHA256SUMS.gpg"
else
  rm -f "$dest/SHA256SUMS.gpg"
  echo "not signed (Verify=no is needed in the transfer files; use --sign for anything real)" >&2
fi

echo "published to $dest:"
( cd "$dest" && ls -l --time-style=+ ecp_* SHA256SUMS* | awk '{printf "  %12s  %s\n", $5, $NF}' )
