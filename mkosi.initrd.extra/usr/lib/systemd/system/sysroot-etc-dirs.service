[Unit]
Description=Directories for the persistent /etc overlay
Documentation=file:///usr/share/doc/foundation/README.md
DefaultDependencies=no
# Wait for /var, and for the RAM disk below it on the installer medium (sysroot-var-lib-ecp.mount).
RequiresMountsFor=/sysroot/var/lib/ecp
Before=sysroot-etc.mount
Conflicts=umount.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Already there on an installed system (the installer seeds them); created fresh when /var starts empty.
ExecStart=/usr/bin/mkdir -p -m 0755 /sysroot/var/lib/ecp/etc/upper
ExecStart=/usr/bin/mkdir -p -m 0700 /sysroot/var/lib/ecp/etc/work
