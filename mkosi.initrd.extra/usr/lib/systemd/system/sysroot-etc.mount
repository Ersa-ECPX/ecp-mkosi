[Unit]
Description=Persistent overlay for /etc
Documentation=file:///usr/share/doc/foundation/README.md
DefaultDependencies=no
# /sysroot/var comes from systemd.mount-extra= on the kernel command line (the installed system names its data
# partition by PARTUUID there; see deploy.py), which the fstab generator turns into mount units before this
# unit is looked at. sysroot-etc-dirs.service waits for those mounts and makes sure the directories exist.
Requires=sysroot-etc-dirs.service
After=sysroot-etc-dirs.service
RequiresMountsFor=/sysroot/var
After=initrd-parse-etc.service
Before=initrd-fs.target
# Only umount.target: a Conflicts= with initrd-switch-root.target would stop (unmount) this overlay
# right before the real system starts, leaving /etc read-only.
Conflicts=umount.target

[Mount]
What=overlay
Where=/sysroot/etc
Type=overlay
# lower: the image's own /etc (new defaults arrive with every OS update); upper: local changes,
# kept across updates; work: scratch space the kernel needs on the same filesystem as upper.
Options=lowerdir=/sysroot/etc,upperdir=/sysroot/var/lib/ecp/etc/upper,workdir=/sysroot/var/lib/ecp/etc/work
