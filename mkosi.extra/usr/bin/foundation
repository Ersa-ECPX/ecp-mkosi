#!/bin/sh
set -eu

usage() {
    printf 'usage: foundation status\n' >&2
    exit 2
}

[ "$#" -eq 1 ] || usage
case "$1" in
    status)
        . /usr/lib/os-release
        if [ "${IMAGE_ID:-}" != ecp ]; then
            echo 'foundation status requires an ECP image' >&2
            exit 1
        fi
        printf 'Platform: ECP — Ersa Compute Platform\n'
        printf 'Base: %s\n' "${PRETTY_NAME:-unknown}"
        printf 'Image: %s %s\n' "${IMAGE_ID:-unknown}" "${IMAGE_VERSION:-unknown}"
        printf 'Architecture: %s\n' "$(uname -m)"
        for path in / /etc /var /home; do
            printf '%s: ' "$path"
            findmnt -n -o SOURCE,FSTYPE,OPTIONS --mountpoint "$path" || printf 'not mounted separately\n'
        done
        printf 'NetworkManager: %s\n' "$(systemctl is-active NetworkManager.service 2>/dev/null || true)"
        printf 'SDDM: %s\n' "$(systemctl is-active sddm.service 2>/dev/null || true)"
        ;;
    *) usage ;;
esac
