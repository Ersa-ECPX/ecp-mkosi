Window.SetBackgroundTopColor(1, 1, 1);
Window.SetBackgroundBottomColor(1, 1, 1);

logo_image = Image("ersa-logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetPosition(Window.GetWidth() / 2 - logo_image.GetWidth() / 2,
                        Window.GetHeight() / 2 - logo_image.GetHeight() / 2 - 36,
                        10);

track_image = Image("track.png");
track_sprite = Sprite(track_image);
track_x = Window.GetWidth() / 2 - track_image.GetWidth() / 2;
track_y = Window.GetHeight() / 2 + 66;
track_sprite.SetPosition(track_x, track_y, 10);

fill_image = Image("fill.png");
fill_sprite = Sprite();
fill_sprite.SetPosition(track_x, track_y, 11);

fun progress_callback(duration, progress) {
    width = Math.Int(track_image.GetWidth() * progress);
    if (width < 1) {
        fill_sprite.SetOpacity(0);
    } else {
        fill_sprite.SetOpacity(1);
        fill_sprite.SetImage(fill_image.Scale(width, fill_image.GetHeight()));
    }
}

Plymouth.SetBootProgressFunction(progress_callback);
