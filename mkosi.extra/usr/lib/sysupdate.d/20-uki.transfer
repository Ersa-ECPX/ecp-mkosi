# Installs the matching UKI on the ESP with a boot counter (+3). systemd-boot tries it,
# systemd-bless-boot confirms it, and after three failures boot falls back to the previous UKI.
[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=https://updates.ersa.invalid/ecp/x86-64/
MatchPattern=ecp_@v.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=ecp_@v+@l-@d.efi \
             ecp_@v+@l.efi \
             ecp_@v.efi
Mode=0444
TriesLeft=3
TriesDone=0
InstancesMax=2
