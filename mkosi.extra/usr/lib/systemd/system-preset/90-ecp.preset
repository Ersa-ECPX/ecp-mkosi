disable systemd-firstboot.service
enable NetworkManager.service
enable gdm.service
enable serial-getty@ttyS0.service
enable tmp.mount
enable systemd-boot-check-no-failures.service
enable bluetooth.service
enable firewalld.service
enable systemd-sysext.service
enable ersa-sysusers-extensions.service
enable ersa-var-init.service
enable foundation-bundles-select.service
enable foundation-bundles-refresh.service
