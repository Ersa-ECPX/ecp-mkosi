# Starts the Bluetooth bridge for the desktop user once the ersa-bluetooth package is installed.
enable ersa-bluetooth.service
# Records that first-boot setup is complete, after GNOME Initial Setup finishes.
enable foundation-provisioning.path
# Tells the user when an installed system update waits for a restart.
enable foundation-update-notify.path
enable foundation-update-notify.service
# Makes the boot splash follow the desktop light or dark style.
enable foundation-splash-sync.service
